# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_cart

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication (Phase 2B/3)
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Twilio (Phase 3)
USE_MOCK_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay (Phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Push Notifications (Phase 7 / 11A)
PUSH_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Maps/Location (Phase 6)
GOOGLE_MAPS_API_KEY=

# Cloudinary (Phase 4)
CLOUDINARY_URL=
